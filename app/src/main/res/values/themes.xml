<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Poetry" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_blue_500</item>
        <item name="colorPrimaryVariant">@color/color_blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/color_blue_300</item>
        <item name="colorSecondaryVariant">@color/color_blue_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/color_blue_700</item>
        <item name="android:windowBackground">@color/background_window</item>
    </style>

    <style name="Toolbar.Poetry" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextAppearance">@style/TextAppearance.Poetry.Toolbar</item>
    </style>

    <style name="TextAppearance.Poetry.Toolbar" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.Poetry.PoemBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.6</item>
        <item name="android:textColor">@color/color_text_body</item>
    </style>
</resources>
