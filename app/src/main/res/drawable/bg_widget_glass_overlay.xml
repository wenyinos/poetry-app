<?xml version="1.0" encoding="utf-8"?>
<!--
  定制微件的玻璃质感层：只负责柔光与边缘高光，不含底色。

  底色是四套配色各自的半透明色，由代码 setBackgroundColor 打在下面那层上；
  本层固定叠在其上，于是四套配色都能有同一份磨砂观感。

  为什么用渐变代替模糊：微件由桌面进程渲染，拿不到壁纸（READ_WALLPAPER_INTERNAL
  是系统权限），也没有可用的模糊接口。而高斯模糊一个渐变得到的仍是渐变，
  观感一致却不必真的跑一遍模糊。

  柔光刻意压得比独立玻璃款淡 —— 这层要同时叠在浅色与深色底上，
  太亮会把深色配色的深底冲淡。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 左上主光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:centerX="0.15"
                android:centerY="0.1"
                android:endColor="#00FFFFFF"
                android:gradientRadius="300dp"
                android:startColor="#33FFFFFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- 右下淡品牌蓝，模拟壁纸色彩被磨砂晕开 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:centerX="0.95"
                android:centerY="1.0"
                android:endColor="#0073C7E8"
                android:gradientRadius="220dp"
                android:startColor="#1F73C7E8"
                android:type="radial" />
        </shape>
    </item>

    <!-- 只有描边，solid 保持全透明才不遮住下面两层 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
