<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_blue_500"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/title_widget_config"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_preview"
                android:textColor="@color/color_text_default"
                android:textSize="13sp" />

            <!--
              预览框：假壁纸上叠半透明底色，再叠玻璃质感，与桌面上的层次一致。

              必须用 ConstraintLayout：两层背景要铺满预览框，但在 FrameLayout 里
              wrap_content 的父容器会被 match_parent 的子 View 撑开（普通 View 在
              AT_MOST 下取的是最大可用高度），预览框会一路长到满屏，下面的配色、
              字号、完成按钮全被顶出屏幕。0dp + 四向约束才是「跟随父容器且不撑大」。
            -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_widget_preview_wall"
                android:minHeight="96dp">

                <View
                    android:id="@+id/previewTint"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/previewContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:shadowColor="#59FFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:text="@string/widget_config_preview_content"
                        android:textColor="@color/color_text_body"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/previewSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:shadowColor="#59FFFFFF"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="6"
                        android:text="@string/widget_config_preview_source"
                        android:textColor="@color/color_text_default"
                        android:textSize="11sp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/widget_config_color"
                android:textColor="@color/color_text_default"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/presetGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/widget_config_size"
                android:textColor="@color/color_text_default"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sizeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:singleLine="true"
                app:singleSelection="true" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sourceSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:checked="true"
                android:text="@string/widget_config_show_source"
                android:textColor="@color/color_text_title"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/doneButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/widget_config_done" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
